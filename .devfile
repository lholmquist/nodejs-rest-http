schemaVersion: 2.2.2
metadata:
  name: nodejs-rest-http
components:
  - name: tools
    container:
      image: quay.io/devfile/universal-developer-image:ubi9-latest
      env:
        - name: NODEJS_DEFAULT_VERSION
          value: 20.18.1
      endpoints:
        - exposure: public
          name: application-index
          protocol: https
          targetPort: 8080
        - exposure: none
          name: debug
          targetPort: 5858
      memoryLimit: 1Gi
      memoryRequest: 512Mi
      cpuLimit: 2000m
      cpuRequest: 500m
      mountSources: true
      volumeMounts:
        - name: npm
          path: /home/user/.npm
  - name: npm
    volume:
      size: 1G
